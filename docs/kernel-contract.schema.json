{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lucasnotfound59/FTC-Knowledge-Bank/blob/main/docs/kernel-contract.schema.json",
  "title": "ftckb kernel JSON contract (schemaVersion 2)",
  "description": "Single-line JSON emitted by `ftckb validate|resolve|check --json`. Success, conflict, and error outputs all validate against this schema. Additive fields are allowed (the contract only adds fields without bumping schemaVersion), so additionalProperties is not restricted.",
  "type": "object",
  "oneOf": [
    {
      "title": "validate",
      "required": ["schemaVersion", "command", "ok", "ruleCount", "violations"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "command": { "const": "validate" },
        "ok": { "type": "boolean" },
        "ruleCount": { "type": "integer", "minimum": 0 },
        "violations": { "type": "array" }
      },
      "not": { "required": ["error"] }
    },
    {
      "title": "resolve",
      "required": ["schemaVersion", "command", "team", "season", "profiles", "ok", "activeRules", "excludedRules", "overriddenRules", "conflicts"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "command": { "const": "resolve" },
        "workMode": { "$ref": "#/definitions/workMode" },
        "team": { "type": "string", "pattern": "^[0-9]+$" },
        "season": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$" },
        "profiles": { "$ref": "#/definitions/profiles" },
        "ok": { "type": "boolean" },
        "activeRules": { "type": "array", "items": { "$ref": "#/definitions/rule" } },
        "excludedRules": { "type": "array", "items": { "$ref": "#/definitions/excludedRule" } },
        "overriddenRules": { "type": "array", "items": { "$ref": "#/definitions/overriddenRule" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/definitions/conflict" } }
      },
      "not": { "required": ["error"] }
    },
    {
      "title": "check",
      "required": ["schemaVersion", "command", "team", "season", "profiles", "ok", "violations", "soft"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "command": { "const": "check" },
        "workMode": { "$ref": "#/definitions/workMode" },
        "team": { "type": "string", "pattern": "^[0-9]+$" },
        "season": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$" },
        "profiles": { "$ref": "#/definitions/profiles" },
        "ok": { "type": "boolean" },
        "violations": { "type": "array", "items": { "$ref": "#/definitions/checkViolation" } },
        "soft": { "type": "array", "items": { "$ref": "#/definitions/soft" } }
      },
      "not": { "required": ["error"] }
    },
    {
      "title": "error",
      "required": ["schemaVersion", "ok", "error"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "command": { "enum": ["validate", "resolve", "check"] },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["usage", "load-error", "invalid-knowledge", "conflict", "context-required", "invalid-context"] },
            "message": { "type": "string" }
          }
        },
        "violations": { "type": "array" }
      }
    }
  ],
  "definitions": {
    "workMode": {
      "description": "Additive field present only for explicit --work-mode test|dev; NORMAL output omits it. Ephemeral per invocation and never stored in project configuration.",
      "enum": ["normal", "test", "dev"]
    },
    "profiles": {
      "type": "array",
      "items": { "enum": ["rookiebot", "simple-opmode", "command-based", "ftclib-command"] },
      "uniqueItems": true
    },
    "rule": {
      "type": "object",
      "required": ["id", "topic", "title", "instruction", "rationale", "status", "authority", "policyLevel", "applicability", "evidence", "checks", "reviewTriggers"],
      "properties": {
        "id": { "type": "string" },
        "topic": { "type": "string" },
        "title": { "type": "string" },
        "instruction": { "type": "string" },
        "rationale": { "type": "string" },
        "status": { "enum": ["approved", "candidate", "deprecated", "rejected"] },
        "authority": { "enum": ["official", "shared", "team"] },
        "policyLevel": { "enum": ["global", "local", "shared"] },
        "applicability": {
          "type": "object",
          "required": ["teams", "seasons", "profiles"],
          "properties": {
            "teams": { "type": "array", "items": { "type": "string" } },
            "seasons": { "type": "array", "items": { "type": "string" } },
            "profiles": { "$ref": "#/definitions/profiles" }
          }
        },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" } },
        "checks": { "type": "array", "items": { "$ref": "#/definitions/check" } },
        "reviewTriggers": { "type": "array", "items": { "$ref": "#/definitions/reviewTrigger" } }
      }
    },
    "reviewTrigger": {
      "type": "object",
      "required": ["paths", "addedLinePatterns"],
      "properties": {
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "addedLinePatterns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "oneOf": [
        {
          "title": "git",
          "required": ["type", "repository", "commit", "file"],
          "properties": {
            "type": { "const": "git" },
            "repository": { "type": "string" },
            "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
            "file": { "type": "string" },
            "symbol": { "type": "string" },
            "line": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "title": "web",
          "required": ["type", "url", "title", "publisher", "accessedAt", "section"],
          "properties": {
            "type": { "const": "web" },
            "url": { "type": "string" },
            "title": { "type": "string" },
            "publisher": { "type": "string" },
            "accessedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "section": { "type": "string" },
            "version": { "type": "string" },
            "product": { "type": "string" },
            "sku": { "type": "string" }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "required": ["kind", "pattern", "note"],
      "properties": {
        "kind": { "enum": ["path_forbidden", "path_required", "regex_required", "regex_forbidden"] },
        "pattern": { "type": "string" },
        "appliesTo": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["topic", "effectiveLevel", "ruleIds", "authorities"],
      "properties": {
        "topic": { "type": "string" },
        "effectiveLevel": { "enum": ["official", "global", "local", "shared"] },
        "ruleIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
        "authorities": {
          "type": "object",
          "additionalProperties": { "enum": ["official", "shared", "team"] }
        }
      }
    },
    "excludedRule": {
      "type": "object",
      "required": ["ruleId", "reasons"],
      "properties": {
        "ruleId": { "type": "string" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["status", "team", "season", "profile", "work-mode-test"] }
        }
      }
    },
    "overriddenRule": {
      "type": "object",
      "required": ["ruleId", "topic", "winnerIds", "effectiveLevel"],
      "properties": {
        "ruleId": { "type": "string" },
        "topic": { "type": "string" },
        "winnerIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "effectiveLevel": { "enum": ["official", "global", "local", "shared"] }
      }
    },
    "checkViolation": {
      "type": "object",
      "required": ["ruleId", "check", "pattern", "detail"],
      "properties": {
        "ruleId": { "type": "string" },
        "check": { "enum": ["path-forbidden", "path-required", "regex-required", "regex-forbidden"] },
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "pattern": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "soft": {
      "type": "object",
      "required": ["ruleId", "note"],
      "properties": {
        "ruleId": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
